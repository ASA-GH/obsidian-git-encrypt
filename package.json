		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"prettier": "^3.8.3",
		"tslib": "2.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^4.1.10"
	},
	"dependencies": {
